# 이 파일을 terraform.tfvars로 복사한 뒤 실제 값을 채워 넣으세요.
# terraform.tfvars는 git에 커밋되지 않습니다 (.gitignore 참고).

aws_region       = "ap-northeast-2"
instance_type    = "t3.micro"
key_pair_name    = "nowhere-pipeline-key"   # AWS 콘솔 > EC2 > 키 페어에서 미리 생성
ssh_allowed_cidr = "0.0.0.0/32"             # 본인 IP/32 로 교체 (curl ifconfig.me 로 확인 가능)
s3_bucket_name   = "nowhere-pipeline-data"
