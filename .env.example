# 이 파일을 .env로 복사한 뒤 실제 값을 채워 넣으세요. .env는 git에 커밋되지 않습니다.
# docker-compose.yml, app/dashboard.py, scripts/fetch_weather.py 공용으로 사용됩니다.

CROWD_APP_PW=
WEATHER_API_KEY=

# AWS S3 백업용 (scripts/upload_to_object_storage.py)
# EC2에 IAM 역할(Instance Profile)을 연결했다면 아래 두 값은 비워둬도 됨
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=nowhere-pipeline-data

# 아래는 docker-compose 환경에서 각 서비스가 자동으로 오버라이드하므로
# 로컬(vm-03 호스트 직접 실행) 환경에서는 비워두면 기본값(localhost)이 사용됩니다.
# DB_HOST=
